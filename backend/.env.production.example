# ─────────────────────────────────────────────────────────────────────────────
# Blue Oceans POS — PRODUCTION environment template (Prompt 43, go-live)
# Copy to backend/.env on the production/staging host and fill real values.
# Never commit the real .env. Rotate JWT_SECRET + DB passwords before go-live.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL connection. Prefer a dedicated app user with least privilege:
#   CREATE USER 'omni_pos'@'%' IDENTIFIED BY '<strong-password>';
#   GRANT ALL PRIVILEGES ON blue_ocean_pos.* TO 'omni_pos'@'%';
# Passwordless local admin (XAMPP/phpMyAdmin) is for DEV ONLY — never in prod.
DATABASE_URL="mysql://omni_pos:<strong-password>@127.0.0.1:3306/blue_ocean_pos"

# Session signing secret — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Store it in the host secret manager / .env with 0600 perms, never in git.
JWT_SECRET="replace-with-64-char-random-secret"

# API listener
PORT=4000
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the API (the frontend(s)):
CORS_ORIGIN="https://pos.yourdomain.com,https://app.yourdomain.com"

# Optional overrides (see db.py / jobs / backups for defaults)
# BACKUP_DIR="/var/lib/omni-pos/backups"
# BACKUP_RETENTION=30
# QUEUE_DB_URL="mysql://omni_pos:<strong-password>@127.0.0.1:3306/blue_ocean_pos"

# Frontend (built at deploy time, see deploy/omni-pos-web.service):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
